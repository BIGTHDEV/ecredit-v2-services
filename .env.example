# Development environment configuration
NODE_ENV=dev
PORT=3035

# SQL Server database connection
DB_SERVER=YOUR_DB_SERVER
DB_INSTANCE_NAME=YOUR_DB_INSTANCE
DB_PORT=1433
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=eCredit
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT configuration
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=24h

# Application URLs
APP_BASE_URL=https://localhost:3035
FRONTEND_BASE_URL=https://localhost:4200
SALESFORCE_BASE_URL=YOUR_SALESFORCE_BASE_URL
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost:4200,http://localhost:3035

# Logging configuration
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_DIRECTORY=./logs

# Attachment storage configuration
ATTACHMENT_STORAGE_DIRECTORY=YOUR_ATTACHMENT_STORAGE_DIRECTORY
ATTACHMENT_PUBLIC_BASE_URL=YOUR_ATTACHMENT_PUBLIC_BASE_URL
ATTACHMENT_MAX_FILE_SIZE=10485760
DEFAULT_ATTACHMENT_TYPE_ID=YOUR_DEFAULT_ATTACHMENT_TYPE_ID

# HTTPS configuration
KEY_PATH=YOUR_PRIVATE_KEY_PATH
CERT_PATH=YOUR_CERTIFICATE_PATH
CA_PATH=YOUR_CA_CERTIFICATE_PATH

# Microsoft Entra ID / MSAL configuration (single-tenant)
MSAL_CLIENT_ID=YOUR_ENTRA_CLIENT_ID
MSAL_TENANT_ID=YOUR_ENTRA_TENANT_ID
MSAL_AUTHORITY=https://login.microsoftonline.com/YOUR_ENTRA_TENANT_ID
MSAL_EXPECTED_AUDIENCE=YOUR_ENTRA_CLIENT_ID
MSAL_EXPECTED_ISSUER=https://login.microsoftonline.com/YOUR_ENTRA_TENANT_ID/v2.0
MSAL_API_CLIENT_ID=YOUR_ENTRA_CLIENT_ID
MSAL_API_SCOPE=api://YOUR_ENTRA_CLIENT_ID/access_as_user
MSAL_GRAPH_ENDPOINT=https://graph.microsoft.com/v1.0/me

# Power Platform company information flow URL (keep signed URLs in the deployment secret store)
POWERPLATFORM_URL=

# Swagger/OpenAPI configuration
SWAGGER_TITLE=e-Credit Express API
SWAGGER_DESCRIPTION=e-Credit backend API with Microsoft Entra ID authentication
SWAGGER_VERSION=1.0.0

# SharePoint attachment storage configuration
ATTACHMENT_STORAGE_PROVIDER=FILE_SHARE
GRAPH_CLIENT_ID=YOUR_GRAPH_CLIENT_ID
GRAPH_CLIENT_SECRET=YOUR_GRAPH_CLIENT_SECRET
GRAPH_DRIVE_ID=YOUR_GRAPH_DRIVE_ID
GRAPH_ROOT_FOLDER_ID=YOUR_GRAPH_ROOT_FOLDER_ID

# Email configuration
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=YOUR_SMTP_USER
EMAIL_SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=YOUR_EMAIL_FROM
EMAIL_BCC=YOUR_EMAIL_BCC

# Application create request URL
APP_CREATE_REQUEST_URL=YOUR_CREATE_REQUEST_URL
HEADER_KEY_CREATE_REQUEST=YOUR_CREATE_REQUEST_HEADER_KEY
HEADER_VALUE_CREATE_REQUEST=YOUR_CREATE_REQUEST_HEADER_VALUE