<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
    body {
        margin: 0;
        padding: 0;
        background: #eef3f1;
        color: #17212b;
        font-family: "Segoe UI", Arial, Helvetica, sans-serif;
        font-size: 14px;
        line-height: 1.5;
    }

    table {
        border-collapse: collapse;
    }

    .email-shell {
        width: 100%;
        background: #eef3f1;
    }

    .email-container {
        width: 80%;
        margin: 24px auto;
        background: #ffffff;
        border: 1px solid #dce8e1;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(23, 58, 43, 0.08);
        overflow: hidden;
    }

    .brand-header {
        background: #075c3d;
        color: #ffffff;
    }

    .brand-header td {
        padding: 30px 36px;
        border-bottom: 4px solid #f39c12;
    }

    .brand-name {
        margin: 0;
        color: #ffffff;
        font-size: 23px;
        letter-spacing: 0.2px;
        font-weight: bold;
        line-height: 1.2;
    }

    .brand-subtitle {
        margin: 6px 0 0;
        color: #d9f2e4;
        font-size: 14px;
    }

    .email-content {
        padding: 34px 36px 28px;
    }

    .greeting {
        margin: 0 0 10px;
        font-size: 16px;
        font-weight: bold;
    }

    .reminder-banner {
        margin: 0 0 18px;
        color: red;
        font-family: Verdana, sans-serif;
        font-size: 20pt;
        font-weight: bolder;
    }

    .intro {
        margin: 0 0 26px;
        color: #52665d;
        font-size: 14px;
    }

    .section-title {
        margin: 28px 0 10px;
        color: #075c3d;
        font-size: 15px;
        letter-spacing: 0.3px;
        font-weight: bold;
    }

    .info-table {
        width: 100%;
        border: 1px solid #dce8e1;
        border-radius: 8px;
        overflow: hidden;
    }

    .info-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #e6efea;
        vertical-align: top;
    }

    .info-table tr:last-child td {
        border-bottom: 0;
    }

    .info-table .label {
        width: 260px;
        background: #f1f7f3;
        color: #315445;
        font-weight: bold;
    }

    .info-table .value {
        color: #17212b;
        word-break: break-word;
    }

    .rating-score {
        color: #009a49;
        font-size: 18px;
        font-weight: bold;
    }

    .credit-detail-table {
        width: 100%;
        border: 1px solid #dce8e1;
        border-radius: 8px;
        overflow: hidden;
    }

    .credit-detail-table th {
        padding: 10px 8px;
        background: #075c3d;
        border: 1px solid #28785a;
        color: #ffffff;
        font-size: 12px;
        font-weight: bold;
        text-align: center;
        vertical-align: middle;
    }

    .credit-detail-table td {
        padding: 11px 8px;
        border: 1px solid #e0ebe5;
        text-align: center;
        vertical-align: top;
    }

    .credit-detail-table td:first-child {
        background: #f1f7f3;
        color: #315445;
        font-weight: bold;
        text-align: left;
    }

    .credit-detail-table .current-step-row td {
        background: #fff4d9;
        font-weight: bold;
    }

    .status-yes {
        color: #009a49;
        font-size: 18px;
        font-weight: bold;
    }

    .status-no {
        color: #c0392b;
        font-size: 18px;
        font-weight: bold;
    }

    .credit-movement {
        width: 100%;
        margin: 0 0 12px;
        border: 1px solid #d6e6da;
    }

    .credit-movement:last-child {
        margin-bottom: 0;
    }

    .credit-movement-header td {
        padding: 10px 12px;
        background: #edf7f1;
        color: #284534;
        font-weight: bold;
    }

    .credit-movement-status {
        display: inline-block;
        margin-left: 6px;
        padding: 2px 8px;
        border-radius: 999px;
        background: #e3f6ec;
        color: #009a49;
        font-size: 12px;
    }

    .credit-movement-meta td {
        padding: 8px 12px;
        border-top: 1px solid #d6e6da;
        color: #667784;
        font-size: 12px;
    }

    .credit-movement-comment td {
        padding: 8px 12px;
        border-top: 1px solid #d6e6da;
        color: #17212b;
    }

    .credit-movement-comment span {
        display: block;
        color: #667784;
        font-size: 12px;
    }

    .credit-movement-values td {
        width: 33.33%;
        padding: 10px 12px;
        border-top: 1px solid #d6e6da;
        vertical-align: top;
    }

    .credit-movement-values span {
        display: block;
        color: #667784;
        font-size: 12px;
    }

    .credit-movement-values strong {
        display: block;
        margin-top: 3px;
        color: #17212b;
        font-size: 14px;
    }

    .conditions-table td {
        border: 0 !important;
    }

    .button-note {
        margin: 8px 0 0;
        color: #667784;
        font-size: 12px;
    }

    .email-footer td {
        padding: 18px 36px;
        background: #f1f6f3;
        color: #60766b;
        font-size: 12px;
    }

    .email-debug-footer td {
        padding: 16px 36px;
        background: #f39c12;
        color: #3d2500;
        font-size: 12px;
    }

    .email-debug-footer strong {
        color: #241500;
    }

    @media screen and (max-width: 640px) {
        body { font-size: 13px; }
        .email-container { width: 100% !important; margin: 0 !important; border: 0 !important; border-radius: 0 !important; }
        .brand-header td { padding: 22px 18px !important; }
        .brand-name { font-size: 20px !important; }
        .brand-subtitle { font-size: 13px !important; }
        .email-content { padding: 24px 16px 20px !important; }
        .section-title { margin-top: 22px; }
        .info-table td { display: block; width: auto !important; padding: 8px 10px !important; }
        .info-table .label { padding-bottom: 3px !important; border-bottom: 0 !important; }
        .info-table .value { padding-top: 3px !important; }
        .credit-detail-table { display: block; width: 100% !important; overflow-x: auto !important; -webkit-overflow-scrolling: touch; }
        .credit-detail-table th, .credit-detail-table td { min-width: 130px; padding: 9px 7px !important; word-break: break-word; }
        .credit-movement-values td { display: block; width: auto !important; }
        .email-footer td, .email-debug-footer td { padding: 16px 18px !important; }
    }
</style>

<table class="email-shell" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
    <tr>
        <td align="center">
            <table class="email-container" role="presentation" width="80%" cellspacing="0" cellpadding="0" border="0">
                <tr class="brand-header">
                    <td>
                        <p class="brand-name">e-Credit System</p>
                        <p class="brand-subtitle">Credit request summary and approval request</p>
                    </td>
                </tr>
                <tr>
                    <td class="email-content">
                        <p class="greeting">Dear {{dear}},</p>
                        {{#if isReminder}}
                        <p class="reminder-banner">Reminder!!</p>
                        {{/if}}
                        <p class="intro">Please review the credit request details below and take the appropriate approval action.</p>

                        <table class="info-table" role="presentation" width="100%" cellspacing="0" cellpadding="0">
                            <tr>
                                <td class="label">No.</td>
                                <td class="value"><a href="{{linkRequestNo}}" target="_blank" style="color: #009a49; font-weight: bold;">{{requestNo}}</a></td>
                            </tr>
                            <tr>
                                <td class="label">CRM No.</td>
                                <td class="value"><a href="{{linkCrmNo}}" target="_blank" style="color: #009a49; font-weight: bold;">{{crmNo}}</a></td>
                            </tr>
                            <tr>
                                <td class="label">Request Type</td>
                                <td class="value">{{requestType}}</td>
                            </tr>
                        </table>

                        <p class="section-title">Customer Information</p>
                        <table class="info-table" role="presentation" width="100%" cellspacing="0" cellpadding="0">
                            <tr>
                                <td class="label">Company Name</td>
                                <td class="value">{{companyName}}</td>
                            </tr>
                            <tr>
                                <td class="label">Sold To No.</td>
                                <td class="value">{{soldToNo}}</td>
                            </tr>
                            <tr>
                                <td class="label">Sales Group</td>
                                <td class="value">{{salesGroup}}</td>
                            </tr>
                            <tr>
                                <td class="label">Business Type (Sold-To Industry)</td>
                                <td class="value">{{businessType}}</td>
                            </tr>
                            <tr>
                                <td class="label">Customer Type (External)</td>
                                <td class="value">{{customerType}}</td>
                            </tr>
                            <tr>
                                <td class="label">Company Register Date</td>
                                <td class="value">{{companyRegisterDate}}</td>
                            </tr>
                            <tr>
                                <td class="label">Registered Capital (THB)</td>
                                <td class="value">{{registeredCapital}}</td>
                            </tr>
                            <tr>
                                <td class="label">Company Size</td>
                                <td class="value">{{companySize}}</td>
                            </tr>
                        </table>

                        <p class="section-title">Credit Proposal Summary</p>
                        <table class="credit-detail-table" role="presentation" width="100%" cellspacing="0"
                            cellpadding="0">
                            <tr>
                                <th>Detail</th>
                                <th>Existing</th>
                                <th>New Proposed by BAE</th>
                                <th>Suggested By Credit Team</th>
                            </tr>
                            <tr>
                                <td>Credit Term</td>
                                <td>{{creditTermExisting}}</td>
                                <td>{{creditTermProposed}}</td>
                                <td>{{suggestedCreditDetails.creditTerm}}</td>
                            </tr>
                            <tr>
                                <td>Credit Limit (THB)</td>
                                <td>{{creditLimitExisting}}</td>
                                <td>{{creditLimitProposed}}</td>
                                <td>{{suggestedCreditDetails.creditLimit}}</td>
                            </tr>
                            <tr>
                                <td>Credit Rating</td>
                                <td>{{creditRatingExisting}}</td>
                                <td>-</td>
                                <td>{{suggestedCreditDetails.creditRating}}</td>
                            </tr>
                        </table>

                        <p class="section-title">Credit Rating Scoring</p>
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                            style="border: 1px solid #d6e6da;">
                            <tr>
                                <td width="25%" align="center" valign="top"
                                    style="padding: 12px 8px; border-right: 1px solid #d6e6da; background-color: #fafdfb; color: #284534;">
                                    <span style="font-size: 12px; font-weight: bold;">Profitability</span><br>
                                    <span
                                        style="color: #009a49; font-size: 22px; font-weight: bold; line-height: 1.6;">{{profitability}}</span>
                                </td>
                                <td width="25%" align="center" valign="top"
                                    style="padding: 12px 8px; border-right: 1px solid #d6e6da; background-color: #fafdfb; color: #284534;">
                                    <span style="font-size: 12px; font-weight: bold;">Growth</span><br>
                                    <span
                                        style="color: #009a49; font-size: 22px; font-weight: bold; line-height: 1.6;">{{growth}}</span>
                                </td>
                                <td width="25%" align="center" valign="top"
                                    style="padding: 12px 8px; border-right: 1px solid #d6e6da; background-color: #fafdfb; color: #284534;">
                                    <span style="font-size: 12px; font-weight: bold;">Liquidity</span><br>
                                    <span
                                        style="color: #009a49; font-size: 22px; font-weight: bold; line-height: 1.6;">{{liquidity}}</span>
                                </td>
                                <td width="25%" align="center" valign="top"
                                    style="padding: 12px 8px; background-color: #fafdfb; color: #284534;">
                                    <span style="font-size: 12px; font-weight: bold;">Leverage</span><br>
                                    <span
                                        style="color: #009a49; font-size: 22px; font-weight: bold; line-height: 1.6;">{{leverage}}</span>
                                </td>
                            </tr>
                            <tr>
                                <td width="25%" align="center" valign="top"
                                    style="padding: 12px 8px; border-right: 1px solid #d6e6da; background-color: #edf7f1; color: #284534;">
                                    <span style="font-size: 12px; font-weight: bold;">Existing</span><br>
                                    <span
                                        style="color: #e67e22; font-size: 22px; font-weight: bold; line-height: 1.6;">{{existingProfitability}}</span>
                                </td>
                                <td width="25%" align="center" valign="top"
                                    style="padding: 12px 8px; border-right: 1px solid #d6e6da; background-color: #edf7f1; color: #284534;">
                                    <span style="font-size: 12px; font-weight: bold;">Existing</span><br>
                                    <span
                                        style="color: #e67e22; font-size: 22px; font-weight: bold; line-height: 1.6;">{{existingGrowth}}</span>
                                </td>
                                <td width="25%" align="center" valign="top"
                                    style="padding: 12px 8px; border-right: 1px solid #d6e6da; background-color: #edf7f1; color: #284534;">
                                    <span style="font-size: 12px; font-weight: bold;">Existing</span><br>
                                    <span
                                        style="color: #e67e22; font-size: 22px; font-weight: bold; line-height: 1.6;">{{existingLiquidity}}</span>
                                </td>
                                <td width="25%" align="center" valign="top"
                                    style="padding: 12px 8px; background-color: #edf7f1; color: #284534;">
                                    <span style="font-size: 12px; font-weight: bold;">Existing</span><br>
                                    <span
                                        style="color: #e67e22; font-size: 22px; font-weight: bold; line-height: 1.6;">{{existingLeverage}}</span>
                                </td>
                            </tr>
                        </table>

                        {{#if showScoringClassification}}
                        <p class="section-title">Special Rating Score Conditions</p>
                        <table class="info-table" role="presentation" width="100%" cellspacing="0" cellpadding="0">
                            <tr>
                                <td class="label">Condition</td>
                                <td class="value">
                                    {{#if scoringClassificationNa}}N/A{{/if}}
                                    {{#if scoringClassificationGovernment}}{{#if
                                    scoringClassificationNa}}<br>{{/if}}Government Hospital &amp; Institution &amp;
                                    Education{{/if}}
                                    {{#if scoringClassificationOthers}}{{#if scoringClassificationNa}}<br>{{/if}}{{#if
                                    scoringClassificationGovernment}}<br>{{/if}}Others{{/if}}
                                </td>
                            </tr>
                            <tr>
                                <td class="label">Comment</td>
                                <td class="value">{{{scoringNotes}}}</td>
                            </tr>
                        </table>
                        {{/if}}

                        <p class="section-title">Credit Team Recommendation</p>
                        <table class="info-table" role="presentation" width="100%" cellspacing="0" cellpadding="0">
                            <tr>
                                <td class="label">Comment</td>
                                <td class="value">{{{opinion}}}</td>
                            </tr>
                            {{#if showAdditionalConditions}}
                            <tr>
                                <td class="label">Clear outstanding balance</td>
                                <td class="value">{{#if clearOutstandingBalance}}<span
                                        class="status-yes">&#10003;</span>{{else}}<span
                                        class="status-no">&#10007;</span>{{/if}}</td>
                            </tr>
                            <tr>
                                <td class="label">Limit credit used to not exceed approved</td>
                                <td class="value">{{#if withinApprovedLimit}}<span
                                        class="status-yes">&#10003;</span>{{else}}<span
                                        class="status-no">&#10007;</span>{{/if}}</td>
                            </tr>
                            <tr>
                                <td class="label">Bank guarantee</td>
                                <td class="value">{{amountBank}}</td>
                            </tr>
                            <tr>
                                <td class="label">Cash deposit</td>
                                <td class="value">{{amountDeposit}}</td>
                            </tr>
                            {{/if}}
                            <tr>
                                <td class="label">Temporary Adjustment</td>
                                <td class="value">{{#if
                                    suggestedCreditDetails.temporaryYes}}{{suggestedCreditDetails.validFrom}} -
                                    {{suggestedCreditDetails.validTo}}{{else}}-{{/if}}</td>
                            </tr>
                            <tr>
                                <td class="label">Permanent Adjustment</td>
                                <td class="value">{{#if
                                    suggestedCreditDetails.permanentYes}}{{suggestedCreditDetails.validFrom}}{{else}}-{{/if}}
                                </td>
                            </tr>
                        </table>

                        <p class="section-title">Summary All Steps</p>
                        {{#if creditDetailsSummary.length}}
                        <table class="credit-detail-table" role="presentation" width="100%" cellspacing="0"
                            cellpadding="0">
                            <tr>
                                <th>No</th>
                                <th>Step</th>
                                <th>By</th>
                                <th>Status</th>
                            </tr>
                            {{#each creditDetailsSummary}}
                            <tr{{#if isCurrentStep}} class="current-step-row" {{else}}{{#if isLastActionedStep}}
                                class="last-actioned-row" {{/if}}{{/if}}>
                                <td>{{step}}</td>
                                <td>{{stepName}}</td>
                                <td>{{approver}}</td>
                                <td>{{status}}</td>
                </tr>
                {{/each}}
            </table>
            {{else}}
            <table class="info-table" role="presentation" width="100%" cellspacing="0" cellpadding="0">
                <tr>
                    <td class="value">No approval steps are available.</td>
                </tr>
            </table>
            {{/if}}

            {{#unless hideLastActionedDetails}}
            <p class="section-title">Latest Approval Action by {{lastActionedStep.approver}}</p>
            <table class="info-table" role="presentation" width="100%" cellspacing="0" cellpadding="0">
                <tr>
                    <td class="label">Comment</td>
                    <td class="value">{{{lastActionedStep.comment}}}</td>
                </tr>
                <tr>
                    <td class="label">Credit Limit</td>
                    <td class="value">{{lastActionedStep.creditLimit}}</td>
                </tr>
                <tr>
                    <td class="label">Credit Term</td>
                    <td class="value">{{lastActionedStep.creditTerm}}</td>
                </tr>
                <tr>
                    <td class="label">Credit Rating</td>
                    <td class="value">{{lastActionedStep.creditRating}}</td>
                </tr>
                <tr>
                    <td class="label">Clear outstanding balance</td>
                    <td class="value">{{#if lastActionedStep.clearOutstandingBalanceYes}}<span
                            class="status-yes">&#10003;</span>{{else}}<span class="status-no">&#10007;</span>{{/if}}
                    </td>
                </tr>
                <tr>
                    <td class="label">Limit credit used to not exceed approved</td>
                    <td class="value">{{#if lastActionedStep.withinApprovedLimitYes}}<span
                            class="status-yes">&#10003;</span>{{else}}<span class="status-no">&#10007;</span>{{/if}}
                    </td>
                </tr>
                <tr>
                    <td class="label">Bank guarantee</td>
                    <td class="value">{{lastActionedStep.bankGuaranteeAmount}}</td>
                </tr>
                <tr>
                    <td class="label">Cash deposit</td>
                    <td class="value">{{lastActionedStep.cashDepositAmount}}</td>
                </tr>
                <tr>
                    <td class="label">Temporary Adjustment</td>
                    <td class="value">{{#if lastActionedStep.temporaryYes}}{{lastActionedStep.validFrom}} -
                        {{lastActionedStep.validTo}}{{else}}-{{/if}}</td>
                </tr>
                <tr>
                    <td class="label">Permanent Adjustment</td>
                    <td class="value">{{#if
                        lastActionedStep.permanentYes}}{{lastActionedStep.validFrom}}{{else}}-{{/if}}</td>
                </tr>
            </table>
            {{/unless}}
            {{#if approvalActions.length}}
            <p class="section-title">&nbsp;</p>
            <table class="MsoNormalTable" role="presentation" border="0" cellspacing="0" cellpadding="0"
                style="border-collapse: collapse; border: 0; width: 100%;">
                <tr>
                    {{#each approvalActions}}
                    <td width=" 150" valign="middle"
                        style="border: 0; width: 112.5pt; background: {{backgroundColor}}; padding: .75pt 7.5pt 2.25pt 7.5pt; height: 26.25pt; border-radius: 3px; box-shadow: 0 2px 4px -0.8px rgba(0,0,0,.25);">
                        <p class="MsoNormal" align="center" style="margin: 0; text-align: center;">
                            <a href="{{url}}" target="_blank"
                                style="display: block; text-decoration: none; font-family: 'Segoe UI Semibold', 'Segoe UI', Arial, sans-serif; font-size: 11.5pt; font-weight: 600; line-height: 1.35; color: {{textColor}};">
                                <span
                                    style="font-size: 11.5pt; color: {{textColor}}; text-decoration: none;">&nbsp;&nbsp;{{label}}&nbsp;</span>
                            </a>
                        </p>
                    </td>
                    {{#unless @last}}
                    <td width="8" aria-hidden="true"
                        style="width: 6pt; padding: .75pt 4pt 2.25pt 4pt; height: 26.25pt; border: 0; font-size: 1pt; line-height: 1pt;">
                        &nbsp;</td>
                    {{/unless}}
                    {{/each}}
                </tr>
            </table>
            {{/if}}
            <p style="margin: 26px 0 4px;">You can access to this request by following 
                <a href="{{link}}" target="_blank" style="color: #009a49; font-weight: bold;">
                    Link
                </a>
            </p>
        </td>
    </tr>
    <tr class="email-footer">
        <td>This is an automated notification from e-Credit System.</td>
    </tr>
    {{#if showEmailDebugInfo}}
    <tr class="email-debug-footer">
        <td>
            <strong>Show for testing only.</strong><br>
            <strong>Subject:</strong> {{emailDebugInfo.subject}}<br>
            <strong>To:</strong> {{#each emailDebugInfo.to}}{{#unless @first}},
            {{/unless}}{{this}}{{else}}-{{/each}}<br>
            <strong>CC:</strong> {{#each emailDebugInfo.cc}}{{#unless @first}}, {{/unless}}{{this}}{{else}}-{{/each}}
        </td>
    </tr>
    {{/if}}
</table>
</td>
</tr>
</table>